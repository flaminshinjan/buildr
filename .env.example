# ===========================================================
#  buildr --- Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to version control.
# ===========================================================

# --- Anthropic (LLM backbone) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (wrapped-openai agent) ---
OPENAI_API_KEY=sk-...

# --- Brave Search (wrapped-brave agent) ---
BRAVE_API_KEY=BSA...

# --- Exa Search (wrapped-exa agent) ---
EEA_API_KEY=...

# --- Firecrawl (wrapped-firecrawl agent) ---
FIRECRAWL_API_KEY=fc-...

# --- Deepgram (wrapped-deepgram / audio transcription agent) ---
DEEPGRAM_API_KEY=...

# --- DeepL (wrapped-deepl / translation agent) ---
DEEPL_API_KEY=...

# --- Perplexity (wrapped-perplexity agent) ---
PERPLEXITY_API_KEY=pplx-...

# --- Stability AI (wrapped-stability / image generation agent) ---
STABILITY_API_KEY=sk-...

# --- Locus (agent-to-agent payments via USDC) ---
LOCUS_API_KEY=...
LOCUS_API_URL=https://api.locus.finance

# --- Database (Neon / any Postgres-compatible) ---
DATABASE_URL=postgresql://user:password@host:5432/buildr

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
